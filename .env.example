# Supabase – Bu iki değeri Supabase Dashboard > Project Settings > API'den alın
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Puan durumu sync (Mackolik) – Railway motoru her gün 17:00’de (TR) bu API'yi çağırır; güvenlik için secret gerekir
CRON_SECRET=your-random-secret-here

# Optaport ↔ site köprüsü
# POST /api/bridge/squad-sync    — Optaport → site tam kadro (maç entegrasyonu için optaport_player_id)
# POST /api/bridge/squad-photos  — yalnızca foto (eski)
# GET  /api/bridge/transfers     — site transfer foto → Optaport
# Bearer veya x-bridge-api-key
BRIDGE_API_KEY=your-bridge-api-key-here

# Supabase Service Role Key – Sadece sunucu tarafında kullanın (sync-standings API). Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin bypass (geçici) – /admin/giris sayfasında "Bypass ile giriş" alanına bu kodu yazınca Supabase kontrolü atlanır
ADMIN_BYPASS_SECRET=your-bypass-code-here

# iyzico Ödeme (Mağaza, bilet, bağış)
IYZICO_API_KEY=your-iyzico-api-key
IYZICO_SECRET_KEY=your-iyzico-secret-key
# Sandbox: https://sandbox-api.iyzipay.com | Canlı: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# iyzico panel → Ayarlar → Firma Ayarları → İşyeri Bildirimleri
# https://www.siteniz.com/api/iyzico/webhook
# (X-IYZ-SIGNATURE-V3; tarayıcı kapanınca da ödenen siparişi kapatır)
# Kanonik site adresi (SEO: sitemap, Open Graph, ödeme callback). Production’da mutlaka tam domain kullanın.
# NEXT_PUBLIC_SITE_URL=https://www.siteniz.com
# Ödeme sonrası yönlendirme için (Vercel’de VERCEL_URL de kullanılır)
# NEXT_PUBLIC_BASE_URL=https://siteniz.com

# Sipariş durum e-postaları (Google Workspace SMTP)
# Vercel → Settings → Environment Variables
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=bilgi@gungorenspor.com
# SMTP_PASS=google_app_password_16_haneli
# MAIL_FROM=bilgi@gungorenspor.com
# MAIL_FROM_NAME=Güngören Spor

# Uyum e-Dönüşüm (mağaza faturası). Değerler Vercel → Settings → Environment Variables.
# Panel: https://edonusum.uyum.com.tr
# Fatura, ödeme onayından 4 gün sonra kesilir. TCKN boşsa 11111111111 yazılır.
# Kullanıcı adı/şifre panel girişi değil, web servis kullanıcısıdır.
# UYUM_USERNAME=
# UYUM_PASSWORD=
# UYUM_SUPPLIER_VKN=
# UYUM_SUPPLIER_TITLE=
# UYUM_SUPPLIER_TAX_OFFICE=
# UYUM_SUPPLIER_ADDRESS=
# UYUM_SUPPLIER_CITY=İstanbul
# UYUM_SUPPLIER_DISTRICT=
# UYUM_SUPPLIER_EMAIL=
# UYUM_SUPPLIER_PHONE=
# Uyum panelindeki 3 harfli fatura serisi
# UYUM_INVOICE_PREFIX=GFK
# Satış fiyatları KDV dahil. Tekstil için genelde 10.
# UYUM_VAT_RATE=10
# UYUM_WEB_ADDRESS=https://gungorenspor.com
# Uyum BasicIntegration HTTPS adresi 404 döner; çalışan adres HTTP'dir.
# UYUM_API_URL=http://edonusumapi.uyum.com.tr/Services/BasicIntegration
# Kargo firması (boşsa kulüp bilgisi yazılır)
# UYUM_CARRIER_VKN=
# UYUM_CARRIER_NAME=
